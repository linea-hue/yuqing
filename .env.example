# 不配置时，前端使用浏览器语音播报；接 D-ID 时改为 did
DIGITAL_HUMAN_PROVIDER=did

# D-ID API
# 不要把密钥写进前端。若密钥格式为 user:password，后端会自动转为 Basic 认证格式。
DID_API_KEY=
# D-ID 必须能够从公网 HTTPS 读取这张真人头像，不能填写 C:\...\xxx.png 或 127.0.0.1 地址
DID_SOURCE_URL=
DID_VOICE_PROVIDER=microsoft
DID_VOICE_ID=zh-CN-XiaoxiaoNeural
# 可选：自定义 D-ID API 地址
DID_API_URL=https://api.d-id.com/talks
DID_API_BASE_URL=https://api.d-id.com

# HeyGen API
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_ASPECT_RATIO=9:16
# 可选：HeyGen 完成后回调你的公网接口
HEYGEN_CALLBACK_URL=

# 如果使用内部数字人网关，可以改为 generic：
# DIGITAL_HUMAN_PROVIDER=generic
# DIGITAL_HUMAN_API_URL=https://your-gateway.example.com/digital-human
# DIGITAL_HUMAN_API_KEY=
# DIGITAL_HUMAN_AVATAR_ID=
